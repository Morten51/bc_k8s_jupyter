<%
   pwd_cfg = "c.NotebookApp.password=u\'sha1:${SALT}:${PASSWORD_SHA1}\'"
   host_port_cfg = "c.NotebookApp.base_url=\'/node/${HOST_CFG}/${PORT_CFG}/\'"

   configmap_filename = "ondemand_config.py"
   configmap_data = "c.NotebookApp.port = 8080"
   utility_img = "ohiosupercomputer/ood-k8s-utils:v1.0.0"

   user = OodSupport::User.new
%>
---
# 1. A dedicated ServiceAccount for this specific job
apiVersion: v1
kind: ServiceAccount
metadata:
  name: jupyter-<%= user.name %>-sa
  namespace: user

---
# 2. A Role that can only get/create ONE specific secret
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: jupyter-<%= user.name %>-secret-manager
  namespace: user
rules:
- apiGroups: [""]
  resources: ["secrets"]
  # This is the crucial part: it only applies to this one secret name
  resourceNames: ["jupyter-<%= user.name %>-secret"]
  verbs: ["get", "create"]

---
# 3. A RoleBinding to connect the ServiceAccount and the Role
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: jupyter-<%= user.name %>-secret-binding
  namespace: user
subjects:
- kind: ServiceAccount
  name: jupyter-<%= user.name %>-sa # <-- The ServiceAccount from above
  namespace: user
roleRef:
  kind: Role
  name: jupyter-<%= user.name %>-secret-manager # <-- The Role from above
  apiGroup: rbac.authorization.k8s.io

---
script:
  accounting_id: "<%= account %>"
  wall_time: "<%= wall_time.to_i * 3600 %>"
  native:
    service_account_name: "jupyter-<%= user.name %>-sa"
    container:
      name: "jupyter"
      image: "scipy-notebook:python-3.9.2"
      command: "/usr/local/bin/start.sh /opt/conda/bin/jupyter notebook --config=/ood/ondemand_config.py"
      working_dir: "<%= Etc.getpwnam(ENV['USER']).dir %>"
      restart_policy: 'OnFailure'
      env:
        NB_UID: "<%= user.uid %>"
        NB_USER: "<%= user.name %>"
        NB_GID: "<%= user.group.id %>"
        HOME: "<%= user.home %>"
      port: "8080"
      cpu: "<%= cpu %>"
      memory: "<%= memory %>Gi"
    configmap:
      files:
        - filename: "<%= configmap_filename %>"
          data: |
            c.NotebookApp.port = 8080
            c.NotebookApp.ip = '0.0.0.0'
            c.NotebookApp.disable_check_xsrf = True
            c.NotebookApp.allow_origin = '*'
            c.Application.log_level = 'DEBUG'
          mount_path: '/ood'
    mounts:
      - type: host
        name: home
        host_type: Directory
        path: <%= user.home %>
        destination_path: <%= user.home %>
    init_containers:
    - name: "init-secret"
      image: "<%= utility_img %>"
      command: 
      - "/bin/save_passwd_as_secret"
      - "user-<%= user.name %>"
    - name: "add-passwd-to-cfg"
      image: "<%= utility_img %>"
      command:
      - "/bin/bash"
      - "-c"
      - "source /bin/passwd_from_secret; source /bin/create_salt_and_sha1; /bin/add_line_to_configmap \\\"<%= pwd_cfg %>\\\" <%= configmap_filename %>"
    - name: "add-hostport-to-cfg"
      image: "<%= utility_img %>"
      command:
      - "/bin/bash"
      - "-c"
      - "source /bin/find_host_port; /bin/add_line_to_configmap \\\"<%= host_port_cfg %>\\\" <%= configmap_filename %>"
